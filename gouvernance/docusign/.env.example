# Fichier de configuration DocuSign — à copier en .env et remplir
# Ne JAMAIS commiter ce fichier dans Git

# === Environnement ===
# Valeurs possibles : "demo" (sandbox développeur) ou "production"
DOCUSIGN_ENV=demo

# === Credentials JWT Grant ===
# À récupérer sur https://admindemo.docusign.com (demo) ou https://admin.docusign.com (production)
# Admin DocuSign > Settings > Apps and Keys

DOCUSIGN_INTEGRATION_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_USER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
DOCUSIGN_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Chemin vers la clé privée RSA (format PEM)
DOCUSIGN_PRIVATE_KEY_PATH=./private.key

# === Paramètres d'envoi par défaut ===
DOCUSIGN_SENDER_NAME=Judith Laithier
DOCUSIGN_SENDER_EMAIL=info@monique-festival.fr
